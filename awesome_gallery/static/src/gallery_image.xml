<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="awesome_gallery.GalleryImage">
        <div class="card w-100 mb-4"
            t-on-click="() => this.onImageClick(this.props.record.id)"
            t-att-data-tooltip="this.props.record[this.props.model.tooltipField]"
            t-att-data-tooltip-template="this.props.tooltipTemplate"
            t-att-data-tooltip-info="this.tooltipInfo">
            <img t-if='this.props.record[this.props.model.imageField]' loading="lazy" t-att-src='this.imageUrl'/>
            <div t-on-click.stop="" class="h-100 opacity-0 opacity-100-hover">
                <FileUploader
                    acceptedFileExtensions="'image/*'"
                    onUploaded.bind="this._onFileUploaded"
                >
                    <t t-set-slot="toggler">
                        <button class="btn btn-secondary position-absolute bottom-0 end-0 m-3"> Upload image </button>
                    </t>
                </FileUploader>
            </div>
        </div>
    </t>
</templates>
