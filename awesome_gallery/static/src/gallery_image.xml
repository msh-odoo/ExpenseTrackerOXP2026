<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="awesome_gallery.GalleryImage">
        <div class="card w-100 mb-4" t-on-click="() => this.onImageClick(this.props.record.id)">
            <img t-if='this.props.record[this.props.model.imageField]' loading="lazy" t-att-src='this.imageUrl'/>
        </div>
    </t>
</templates>
