<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="expense_tracker.Dialog">
        <div class="o_dialog" t-att-id="this.id">
            <div role="dialog" class="modal d-block o_technical_modal"
                tabindex="-1"
                t-attf-class="o_modal_design_{{ this.design }} {{ !this.props.withBodyPadding ? 'o_modal_no_body_padding': 'o_modal_body_padding' }}"
                t-ref="this.modalRef"
                >
                <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" t-attf-class="modal-{{ this.size }}">
                    <div class="modal-content" t-att-class="this.props.contentClass">
                        <header t-if="this.props.header" class="modal-header">
                            <t t-call-slot="header">
                                <t t-call="expense_tracker.Dialog.header"/>
                            </t>
                        </header>
                        <main class="modal-body" t-attf-class="{{ this.props.bodyClass }}">
                            <t t-call-slot="default"/>
                        </main>
                        <footer t-if="this.props.footer" class="modal-footer d-empty-none justify-content-around justify-content-md-start flex-wrap gap-2 w-100">
                            <t t-call-slot="footer"/>
                        </footer>
                    </div>
                </div>
            </div>
        </div>
    </t>

    <t t-name="expense_tracker.Dialog.header">
        <h4 class="modal-title text-wrap text-break fs-3 flex-grow-1" t-att-class="{ 'me-auto ms-3': fullscreen }">
            <t t-out="window.String(this.props.title)"/>
        </h4>
    </t>
</templates>
