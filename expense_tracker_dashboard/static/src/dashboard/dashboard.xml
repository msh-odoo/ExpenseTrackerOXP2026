<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="expense_tracker_dashboard.ExpenseDashboard">
        <Layout display="display" className="'o_dashboard h-100'">
            <t t-set-slot="layout-buttons">
                <button class="btn btn-primary" t-on-click="this.openExpenseView">Expenses</button>
                <button class="btn btn-primary" t-on-click="this.openCategories">Categories</button>
            </t>
            <t t-set-slot="control-panel-additional-actions">
                <button t-on-click="this.openConfiguration" class="btn p-0 ms-1 border-0">
                    <i class="fa fa-cog"></i>
                </button>
            </t>
            <div class="d-flex flex-wrap">
                <t t-foreach="this.items" t-as="item" t-key="item.id">
                    <DashboardItem t-if="!this.state.disabledItems.includes(item.id)" size="item.size || 1">
                        <t t-set="itemProp" t-value="item.props ? item.props(statistics) : {'data': statistics}"/>
                        <t t-component="item.Component" />
                    </DashboardItem>
                </t>
            </div>
        </Layout>
    </t>

    <t t-name="awesome_dashboard.ConfigurationDialog">
        <Dialog title="'Dashboard items configuration'">
            Which cards do you whish to see ?
            <t t-foreach="this.items" t-as="item" t-key="item.id">
                <CheckBox value="item.enabled" onChange="(ev) => this.onChange(ev, item)">
                    <t t-esc="item.description"/>
                </CheckBox>
            </t>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="this.done">
                    Done
                </button>
            </t>
        </Dialog>
    </t>

</templates>
